<?xml version="1.0" encoding="utf-8"?>
<!-- 연결됐어요: 같은 색·번호 화면으로 서로 찾기 + 진행 단계 + 인증서 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange_match"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            style="@style/Black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="연결됐어요"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/cancel"
            style="@style/Black"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="취소"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/Black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="이 색 화면을 든 사람을 찾으세요"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="96sp"
                android:textStyle="bold"
                tools:text="47" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="두 폰에 같은 색과 번호가 떠요"
                android:textSize="15sp" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:id="@+id/partnerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:gravity="center_vertical">

                    <com.example.morningconnect.CharacterView
                        android:id="@+id/avatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/box_avatar"
                        android:importantForAccessibility="no"
                        android:padding="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="상대방 인상착의"
                            android:textColor="@color/sub"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/partnerLook"
                            style="@style/Black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="16sp"
                            tools:text="베이지 코트 · 검정 바지 · 백팩" />

                        <TextView
                            android:id="@+id/partnerSeat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/sub"
                            android:textSize="13sp"
                            tools:text="3-2 문 오른쪽 · 끝에서 두 번째 자리" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/step1"
                    layout="@layout/item_step" />

                <include
                    android:id="@+id/step2"
                    layout="@layout/item_step" />

                <include
                    android:id="@+id/step3"
                    layout="@layout/item_step" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cert"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textSize="19sp"
        app:backgroundTint="@color/btn_dark"
        app:icon="@drawable/ic_qr"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="26dp"
        app:iconTint="@color/white"
        tools:text="인증서 보여주기" />

    <TextView
        android:id="@+id/certHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        tools:text="상대가 인증서를 스캔하면 인계가 확정돼요" />
</LinearLayout>
