<?xml version="1.0" encoding="utf-8"?>
<!-- 이곳 사진: 역 주변 사진 (분류 · 대표 사진 · 목록 · 다음 역 미리 보기 · 올리기) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="뒤로"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textSize="23sp"
                    tools:text="강남역 이곳 사진" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub"
                    android:textSize="13sp"
                    tools:text="지나가는 역 주변 · 사용자들이 올린 사진" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filters"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>

                <!-- 대표 사진 -->
                <FrameLayout
                    android:id="@+id/featured"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/box_photo"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/featuredImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:padding="24dp"
                        android:textColor="@color/sub"
                        android:textSize="15sp"
                        tools:text="아직 올라온 사진이 없어요\n첫 사진을 올려 주세요" />

                    <TextView
                        android:id="@+id/featuredCaption"
                        style="@style/Black"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/pill_dark"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="11번 출구 앞 · 20분 전" />

                    <TextView
                        android:id="@+id/like"
                        style="@style/Black"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/pill"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="15sp"
                        app:drawableStartCompat="@drawable/ic_heart"
                        tools:text="24" />
                </FrameLayout>

                <GridLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="17dp"
                    android:columnCount="3" />

                <!-- 다음 역 미리 보기 -->
                <LinearLayout
                    android:id="@+id/other"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="20dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/box_soft"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/green_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/otherTitle"
                            style="@style/Black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            tools:text="다음 역 교대 사진 미리 보기" />

                        <TextView
                            android:id="@+id/otherCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sub"
                            android:textSize="13sp"
                            tools:text="18장" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/upload"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="사진 올리기"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/green_dark"
        app:icon="@drawable/ic_camera"
        app:iconTint="@color/white"
        app:shapeAppearanceOverlay="@style/Fab" />
</FrameLayout>
