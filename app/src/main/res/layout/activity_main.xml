<?xml version="1.0" encoding="utf-8"?>
<!-- 홈: 노선 위치 + 원형 메뉴 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 호선 -->
    <TextView
        android:id="@+id/lineBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/green"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lineName"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="호선 외선순환"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/lineBadge"
        app:layout_constraintStart_toEndOf="@id/lineBadge"
        app:layout_constraintTop_toTopOf="@id/lineBadge" />

    <TextView
        android:id="@+id/carCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:drawablePadding="4dp"
        android:drawableTint="@color/sub"
        android:gravity="center_vertical"
        android:text="같은 칸 7명"
        android:textColor="@color/sub"
        android:textSize="15sp"
        app:drawableStartCompat="@drawable/ic_bluetooth"
        app:layout_constraintBottom_toBottomOf="@id/lineBadge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lineBadge" />

    <!-- 노선도: 역삼 - 강남(지금) - 교대 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gPrev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.21" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.785" />

    <View
        android:id="@+id/track"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:background="@color/green"
        app:layout_constraintEnd_toStartOf="@id/trackArrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lineBadge" />

    <ImageView
        android:id="@+id/trackArrow"
        android:layout_width="10dp"
        android:layout_height="14dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/arrow_head"
        app:layout_constraintBottom_toBottomOf="@id/track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/track" />

    <View
        android:id="@+id/stopPrev"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/station"
        app:layout_constraintBottom_toBottomOf="@id/track"
        app:layout_constraintEnd_toEndOf="@id/gPrev"
        app:layout_constraintStart_toStartOf="@id/gPrev"
        app:layout_constraintTop_toTopOf="@id/track" />

    <View
        android:id="@+id/stopNow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/station_now"
        app:layout_constraintBottom_toBottomOf="@id/track"
        app:layout_constraintEnd_toEndOf="@id/gNow"
        app:layout_constraintStart_toStartOf="@id/gNow"
        app:layout_constraintTop_toTopOf="@id/track" />

    <View
        android:id="@+id/stopNext"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/station"
        app:layout_constraintBottom_toBottomOf="@id/track"
        app:layout_constraintEnd_toEndOf="@id/gNext"
        app:layout_constraintStart_toStartOf="@id/gNext"
        app:layout_constraintTop_toTopOf="@id/track" />

    <TextView
        android:id="@+id/prevName"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="역삼"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="@id/gPrev"
        app:layout_constraintStart_toStartOf="@id/gPrev"
        app:layout_constraintTop_toBottomOf="@id/track" />

    <TextView
        android:id="@+id/prevRoman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yeoksam"
        android:textColor="@color/sub"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/gPrev"
        app:layout_constraintStart_toStartOf="@id/gPrev"
        app:layout_constraintTop_toBottomOf="@id/prevName" />

    <TextView
        android:id="@+id/nowName"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="강남"
        android:textSize="38sp"
        app:layout_constraintEnd_toEndOf="@id/gNow"
        app:layout_constraintStart_toStartOf="@id/gNow"
        app:layout_constraintTop_toBottomOf="@id/track" />

    <TextView
        android:id="@+id/nowRoman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gangnam"
        android:textColor="@color/sub"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/gNow"
        app:layout_constraintStart_toStartOf="@id/gNow"
        app:layout_constraintTop_toBottomOf="@id/nowName" />

    <TextView
        android:id="@+id/nextName"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="교대"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="@id/gNext"
        app:layout_constraintStart_toStartOf="@id/gNext"
        app:layout_constraintTop_toBottomOf="@id/track" />

    <TextView
        android:id="@+id/nextRoman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gyodae"
        android:textColor="@color/sub"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/gNext"
        app:layout_constraintStart_toStartOf="@id/gNext"
        app:layout_constraintTop_toBottomOf="@id/nextName" />

    <!-- 내릴 역 -->
    <TextView
        android:id="@+id/dest"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:text="사당에서 내려요"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nowRoman" />

    <TextView
        android:id="@+id/remain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="4정거장 남음"
        android:textColor="@color/sub"
        android:textSize="15sp"
        app:layout_constraintBaseline_toBaselineOf="@id/dest"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 원형 메뉴 -->
    <View
        android:id="@+id/ring"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/ring_home"
        app:layout_constraintBottom_toTopOf="@id/hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dest"
        app:layout_constraintVertical_bias="0.65" />

    <View
        android:id="@+id/halo"
        android:layout_width="152dp"
        android:layout_height="152dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/halo"
        app:layout_constraintBottom_toBottomOf="@id/ring"
        app:layout_constraintEnd_toEndOf="@id/ring"
        app:layout_constraintStart_toStartOf="@id/ring"
        app:layout_constraintTop_toTopOf="@id/ring" />

    <LinearLayout
        android:id="@+id/seat"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/green"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/ring"
        app:layout_constraintEnd_toEndOf="@id/ring"
        app:layout_constraintStart_toStartOf="@id/ring"
        app:layout_constraintTop_toTopOf="@id/ring">

        <TextView
            style="@style/Black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="곧 내려요"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="같은 칸에 알리기"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/look"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_outline"
        android:contentDescription="오늘의 룩"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shirt"
        app:layout_constraintCircle="@id/ring"
        app:layout_constraintCircleAngle="0"
        app:layout_constraintCircleRadius="124dp" />

    <ImageButton
        android:id="@+id/talk"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_outline"
        android:contentDescription="오픈톡"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chat"
        app:layout_constraintCircle="@id/ring"
        app:layout_constraintCircleAngle="72"
        app:layout_constraintCircleRadius="124dp" />

    <ImageButton
        android:id="@+id/game"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_outline"
        android:contentDescription="미니게임"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dice"
        app:layout_constraintCircle="@id/ring"
        app:layout_constraintCircleAngle="144"
        app:layout_constraintCircleRadius="124dp" />

    <ImageButton
        android:id="@+id/news"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_outline"
        android:contentDescription="뉴스"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_news"
        app:layout_constraintCircle="@id/ring"
        app:layout_constraintCircleAngle="216"
        app:layout_constraintCircleRadius="124dp" />

    <ImageButton
        android:id="@+id/photo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_outline"
        android:contentDescription="이곳 사진"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_camera"
        app:layout_constraintCircle="@id/ring"
        app:layout_constraintCircleAngle="288"
        app:layout_constraintCircleRadius="124dp" />

    <TextView
        android:id="@+id/lookLabel"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:text="오늘의 룩"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/look"
        app:layout_constraintStart_toStartOf="@id/look"
        app:layout_constraintTop_toBottomOf="@id/look" />

    <TextView
        android:id="@+id/talkLabel"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:text="오픈톡"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/talk"
        app:layout_constraintStart_toStartOf="@id/talk"
        app:layout_constraintTop_toBottomOf="@id/talk" />

    <TextView
        android:id="@+id/gameLabel"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:text="미니게임"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/game"
        app:layout_constraintStart_toStartOf="@id/game"
        app:layout_constraintTop_toBottomOf="@id/game" />

    <TextView
        android:id="@+id/newsLabel"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:text="뉴스"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/news"
        app:layout_constraintStart_toStartOf="@id/news"
        app:layout_constraintTop_toBottomOf="@id/news" />

    <TextView
        android:id="@+id/photoLabel"
        style="@style/Black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:text="이곳 사진"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/photo"
        app:layout_constraintStart_toStartOf="@id/photo"
        app:layout_constraintTop_toBottomOf="@id/photo" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:text="내리기 1~2정거장 전에 눌러 주세요"
        android:textColor="@color/sub"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
