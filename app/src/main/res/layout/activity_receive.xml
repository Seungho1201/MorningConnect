<?xml version="1.0" encoding="utf-8"?>
<!-- 새 자리 알림 받기 (어두운 화면) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/circle"
            android:backgroundTint="@color/green"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/route"
            style="@style/Black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="강남 → 교대" />

        <TextView
            android:id="@+id/carCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_sub"
            android:textSize="14sp"
            tools:text="같은 칸 7명" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Pill"
                        android:layout_height="32dp"
                        android:background="@drawable/pill_orange"
                        android:clickable="false"
                        android:focusable="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="새 자리 알림"
                        android:textColor="@color/orange_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/via"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="방금 · 블루투스로 받음"
                        android:textColor="@color/sub"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    style="@style/Black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityHeading="true"
                    android:lineSpacingExtra="2dp"
                    android:textSize="27sp"
                    tools:text="3-2 문 오른쪽 자리가\n곧 비어요" />

                <TextView
                    android:id="@+id/when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/sub"
                    android:textSize="15sp"
                    tools:text="2정거장 뒤 사당에서 내릴 예정이에요" />

                <com.example.morningconnect.SeatMapView
                    android:id="@+id/seatMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/box_chip"
                    android:padding="12dp" />

                <LinearLayout
                    android:id="@+id/giver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:focusable="true"
                    android:gravity="center_vertical">

                    <com.example.morningconnect.CharacterView
                        android:id="@+id/avatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/box_avatar"
                        android:importantForAccessibility="no"
                        android:padding="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lookText"
                            style="@style/Black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            tools:text="검정 패딩 · 청바지 · 흰 운동화" />

                        <TextView
                            android:id="@+id/trust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/sub"
                            android:textSize="14sp"
                            tools:text="신뢰도 96 · 약속 이행 42/43회" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_dark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/white"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                tools:text="가장 먼저 '갈게요'를 누른 한 명만 연결돼요" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/go"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="갈게요"
        android:textColor="@color/ink"
        android:textSize="19sp"
        app:backgroundTint="@color/btn_orange"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/no"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:text="괜찮아요"
        android:textStyle="normal"
        app:backgroundTint="@color/dark_card"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
